<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Stages every WACS wasi-nn backend NuGet into a single bin dir
      that the launch scripts (run-llm.sh, run-genai.sh) point
      BACKEND_DLL at.

      EnableDynamicLoading makes MSBuild copy each package's managed
      dependencies + RID-specific native libs (libtorch, libllama,
      LibTorchSharp, libonnxruntime, runtimes/RID/native/*) into the
      bin alongside the backend assembly. Combined with WACS's
      BindBackendLoadContext (gap 30 in the historical report),
      Assembly.LoadFrom of any of these dlls resolves its whole
      transitive managed + native graph from this bin without manual
      staging.

      Pinned versions; bump as needed when newer NuGets ship.
    -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <!-- Suppress NU1903 / NU1701-style noise from transitive deps
             that this stager project doesn't itself ship. -->
        <NoWarn>$(NoWarn);NU1701;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WACS.WASI.NN.OnnxRuntime"      Version="0.3.2" />
        <PackageReference Include="WACS.WASI.NN.OnnxRuntimeGenAI" Version="0.1.5" />
        <PackageReference Include="WACS.WASI.NN.LlamaSharp"       Version="0.2.4" />
        <PackageReference Include="WACS.WASI.NN.TorchSharp"       Version="0.1.3" />
        <PackageReference Include="WACS.WASI.NN.MLNet"            Version="0.2.4" />
        <PackageReference Include="WACS.WASI.NN.OpenVino"         Version="0.2.1" />
    </ItemGroup>

    <!--
      OpenVINO.CSharp.API ships only managed bindings; the actual
      libopenvino_c.dylib / .dll / .so lives in per-RID native NuGets
      that are NOT transitive deps. Reference the platforms we
      currently demo — Linux x86_64 / Linux arm64 / Windows.

      macOS arm64 is held back pending the WACS-side fix tracked in
      WACS-GAPS.md gap 34 (compile_model trips the C# wrapper's
      empty-Dictionary bug). The native NuGet is published —
      OpenVINO.runtime.macos-arm64 2026.1.0 — and the IR conversion
      side is unblocked; just need the one-line WACS patch. Until
      then scripts/fetch-embed-model.sh + run-embed.sh hard-exit on
      Darwin and we skip staging the macOS natives so the bin
      stays small.
    -->
    <ItemGroup>
        <PackageReference Include="OpenVINO.runtime.macos-arm64"       Version="2026.1.0" />
        <PackageReference Include="OpenVINO.runtime.win"               Version="2026.0.0" />
        <PackageReference Include="OpenVINO.runtime.ubuntu.22-x86_64"  Version="2024.4.0.1" />
        <PackageReference Include="OpenVINO.runtime.ubuntu.20-arm64"   Version="2024.4.0.1" />
    </ItemGroup>

</Project>
